# Copy to .env and fill in. Never commit .env.

# Anthropic (backend only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase (backend only; the browser never talks to Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Neo4j. Local docker compose uses bolt://neo4j:7687 inside the network and
# bolt://localhost:7687 from the host. Production uses AuraDB Free (neo4j+s://...).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only

# Supabase Postgres connection string, used by the LangGraph checkpointer
DATABASE_URL=

# The only origin allowed by backend CORS
WEB_ORIGIN=http://localhost:5173

# Frontend (read by Vite at build time)
VITE_API_URL=http://localhost:8000
